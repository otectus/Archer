+ /* Fan commands are multi-step transactions. Never retain a partial manual
+  * transition after an ACPI failure. The auto command is upstream's command.
+  */
+ static DEFINE_MUTEX(acer_fan_lock);
+
+ static bool acer_has_fan_control(void)
+ {
+     return wmi_has_guid(WMID_GUID4) &&
+         (has_cap(ACER_CAP_PREDATOR_SENSE) || has_cap(ACER_CAP_NITRO_SENSE) ||
+          has_cap(ACER_CAP_NITRO_SENSE_V4));
+ }
+
+ static acpi_status acer_set_fan_speed(int cpu, int gpu)
+ {
+     acpi_status status;
+
+     if (cpu < 0 || cpu > 100 || gpu < 0 || gpu > 100)
+         return AE_BAD_PARAMETER;
+     if (!acer_has_fan_control())
+         return AE_SUPPORT;
+     mutex_lock(&acer_fan_lock);
+     status = acer_do_set_fan_speed(cpu, gpu);
+     if (ACPI_FAILURE(status) && (cpu || gpu)) {
+         if (ACPI_FAILURE(acer_do_set_fan_speed(0, 0)))
+             pr_err("Fan write failed AND automatic fan restoration failed\n");
+     }
+     mutex_unlock(&acer_fan_lock);
+     return status;
+ }
+
+ static void acer_restore_auto(void)
+ {
+     if (acer_has_fan_control() && ACPI_FAILURE(acer_set_fan_speed(0, 0)))
+         pr_err("Unable to restore automatic fan control\n");
+ }
