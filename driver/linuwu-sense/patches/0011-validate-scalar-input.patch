  /*
   * USB Charging
   */
+ /* Counted unsigned scalar parser: reject signs, overflow and trailing data. */
+ static int archer_parse_scalar(const char *buf, size_t count, u8 *value)
+ {
+     char input[5];
+     size_t i, length = count;
+
+     if (!count || count >= sizeof(input) || memchr(buf, '\0', count))
+         return -EINVAL;
+     memcpy(input, buf, count);
+     if (input[length - 1] == '\n')
+         length--;
+     if (!length)
+         return -EINVAL;
+     input[length] = '\0';
+     for (i = 0; i < length; i++)
+         if (input[i] < '0' || input[i] > '9')
+             return -EINVAL;
+     return kstrtou8(input, 10, value);
+ }
+
